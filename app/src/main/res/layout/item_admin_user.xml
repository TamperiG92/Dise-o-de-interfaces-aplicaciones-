<?xml version="1.0" encoding="utf-8"?>
<com.google.android.material.card.MaterialCardView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginHorizontal="16dp"
    android:layout_marginBottom="8dp"
    app:cardBackgroundColor="@color/surface_card"
    app:cardCornerRadius="12dp"
    app:strokeWidth="1dp"
    app:strokeColor="#14FFFFFF">

    <androidx.constraintlayout.widget.ConstraintLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:padding="16dp">

        <!-- Avatar Circle -->
        <TextView
            android:id="@+id/tv_avatar_initials"
            android:layout_width="40dp"
            android:layout_height="40dp"
            android:background="@drawable/circle_background"
            android:backgroundTint="#0A3A40"
            android:gravity="center"
            android:textColor="@color/cyan_primary"
            android:textSize="14sp"
            android:textStyle="bold"
            tools:text="JD"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent" />

        <!-- Name -->
        <TextView
            android:id="@+id/tv_user_name"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="12dp"
            android:textColor="@color/white"
            android:textSize="15sp"
            android:textStyle="bold"
            tools:text="Julián Díaz"
            app:layout_constraintEnd_toStartOf="@+id/tv_motorcycle"
            app:layout_constraintStart_toEndOf="@id/tv_avatar_initials"
            app:layout_constraintTop_toTopOf="parent" />

        <!-- Motorcycle -->
        <TextView
            android:id="@+id/tv_motorcycle"
            android:layout_width="100dp"
            android:layout_height="wrap_content"
            android:textColor="@color/gris_hint"
            android:textSize="13sp"
            android:gravity="start"
            tools:text="MT-09 SP"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintEnd_toStartOf="@+id/layout_dots"
            app:layout_constraintTop_toTopOf="parent" />

        <!-- Status Dots -->
        <LinearLayout
            android:id="@+id/layout_dots"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintTop_toTopOf="parent">

            <View
                android:id="@+id/dot_1"
                android:layout_width="10dp"
                android:layout_height="10dp"
                android:layout_marginEnd="6dp"
                android:background="@drawable/circle_background"
                android:backgroundTint="@color/cyan_primary" />

            <View
                android:id="@+id/dot_2"
                android:layout_width="10dp"
                android:layout_height="10dp"
                android:background="@drawable/circle_background"
                android:backgroundTint="@color/alert_red" />
        </LinearLayout>

    </androidx.constraintlayout.widget.ConstraintLayout>

</com.google.android.material.card.MaterialCardView>
