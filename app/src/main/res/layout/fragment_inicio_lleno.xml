<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:padding="24dp">

    <!-- Top Bar: Avatar & Bell -->
    <LinearLayout
        android:id="@+id/ll_top_bar"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        app:layout_constraintTop_toTopOf="parent">

        <ImageView
            android:layout_width="40dp"
            android:layout_height="40dp"
            android:src="@mipmap/ic_launcher_round"
            android:background="@drawable/design_snackbar_background"
            android:backgroundTint="@color/surface_variant" />

        <TextView
            android:id="@+id/txt_moto_nombre_inicio"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:layout_marginStart="12dp"
            android:text="RodApp"
            android:textColor="@color/text_light"
            android:textSize="20sp"
            android:textStyle="bold" />

        <ImageView
            android:layout_width="24dp"
            android:layout_height="24dp"
            android:src="@android:drawable/ic_popup_reminder"
            app:tint="@color/text_gray" />
    </LinearLayout>

    <!-- Mega Card: Odometer -->
    <com.google.android.material.card.MaterialCardView
        android:id="@+id/card_megaodo"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="24dp"
        app:cardBackgroundColor="@color/surface_card"
        app:cardCornerRadius="20dp"
        app:strokeWidth="0dp"
        app:layout_constraintTop_toBottomOf="@id/ll_top_bar">

        <androidx.constraintlayout.widget.ConstraintLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content">
            
            <!-- Pseudo Background Image Gradient -->
            <View
                android:id="@+id/odo_bg"
                android:layout_width="match_parent"
                android:layout_height="120dp"
                android:background="@color/surface_stroke"
                app:layout_constraintTop_toTopOf="parent" />

            <TextView
                android:id="@+id/lbl_estado"
                style="@style/SectionHeaderStyle"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="16dp"
                android:layout_marginStart="20dp"
                android:text="@string/label_estado_moto"
                android:textColor="@color/cyan_primary"
                android:textSize="10sp"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toBottomOf="@id/odo_bg" />

            <TextView
                android:id="@+id/tv_km"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:text="@string/label_km_ejemplo"
                android:textColor="@color/text_light"
                android:textSize="28sp"
                android:textStyle="bold"
                app:layout_constraintStart_toStartOf="@id/lbl_estado"
                app:layout_constraintTop_toBottomOf="@id/lbl_estado" />

            <TextView
                android:id="@+id/tv_km_sub"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/label_kilometraje_total"
                android:textColor="@color/text_gray"
                android:textSize="12sp"
                app:layout_constraintStart_toStartOf="@id/lbl_estado"
                app:layout_constraintTop_toBottomOf="@id/tv_km" />

            <!-- Oil Widget -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical"
                android:background="@drawable/design_snackbar_background"
                android:backgroundTint="@color/surface_dark"
                android:layout_margin="20dp"
                android:padding="16dp"
                app:layout_constraintTop_toBottomOf="@id/tv_km_sub"
                app:layout_constraintBottom_toBottomOf="parent">

                <ImageView
                    android:layout_width="24dp"
                    android:layout_height="24dp"
                    android:src="@android:drawable/ic_menu_preferences"
                    app:tint="@color/cyan_primary" />

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="16dp"
                    android:orientation="vertical">
                    
                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/label_proximo_aceite"
                        android:textColor="@color/text_light"
                        android:textSize="14sp"
                        android:textStyle="bold" />
                        
                    <ProgressBar
                        android:id="@+id/progress_aceite"
                        style="?android:attr/progressBarStyleHorizontal"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="8dp"
                        android:max="100"
                        android:progress="0"
                        android:progressTint="@color/cyan_primary" />
                        
                    <TextView
                        android:id="@+id/txt_aceite_estado"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="4dp"
                        android:text="@string/label_estimado_aceite"
                        android:textColor="@color/cyan_primary"
                        android:textSize="10sp" />
                </LinearLayout>
            </LinearLayout>

        </androidx.constraintlayout.widget.ConstraintLayout>
    </com.google.android.material.card.MaterialCardView>

    <!-- Botón Iniciar a rodar -->
    <com.google.android.material.button.MaterialButton
        android:id="@+id/btn_iniciar_ruta"
        android:layout_width="match_parent"
        android:layout_height="56dp"
        android:layout_marginTop="16dp"
        android:text="@string/label_iniciar_ruta"
        android:textColor="@color/black"
        android:textSize="15sp"
        android:textStyle="bold"
        app:backgroundTint="@color/success_green"
        app:cornerRadius="16dp"
        app:iconGravity="textStart"
        app:iconPadding="8dp"
        app:layout_constraintTop_toBottomOf="@id/card_megaodo" />

    <!-- Card EN RUTA (visible solo mientras hay sesión activa) -->
    <com.google.android.material.card.MaterialCardView
        android:id="@+id/card_en_ruta"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="16dp"
        android:visibility="gone"
        app:cardBackgroundColor="@color/surface_success"
        app:cardCornerRadius="16dp"
        app:strokeColor="@color/success_green"
        app:strokeWidth="1dp"
        app:layout_constraintTop_toBottomOf="@id/btn_iniciar_ruta">

        <androidx.constraintlayout.widget.ConstraintLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:padding="16dp">

            <View
                android:id="@+id/dot_ruta"
                android:layout_width="8dp"
                android:layout_height="8dp"
                android:background="@drawable/design_snackbar_background"
                android:backgroundTint="@color/success_green"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toTopOf="parent" />

            <TextView
                android:id="@+id/txt_en_ruta_label"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="8dp"
                android:text="@string/label_en_ruta"
                android:textColor="@color/success_green"
                android:textSize="11sp"
                android:textStyle="bold"
                android:letterSpacing="0.1"
                app:layout_constraintStart_toEndOf="@id/dot_ruta"
                app:layout_constraintTop_toTopOf="@id/dot_ruta"
                app:layout_constraintBottom_toBottomOf="@id/dot_ruta"
                app:layout_constraintEnd_toStartOf="@id/txt_timer_ruta" />

            <TextView
                android:id="@+id/txt_timer_ruta"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="00:00:00"
                android:textColor="@color/text_gray"
                android:textSize="11sp"
                android:fontFamily="monospace"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintTop_toTopOf="parent" />

            <TextView
                android:id="@+id/txt_km_ruta"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:text="0.0 km recorridos"
                android:textColor="@color/text_light"
                android:textSize="22sp"
                android:textStyle="bold"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toBottomOf="@id/dot_ruta" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btn_finalizar_ruta"
                android:layout_width="match_parent"
                android:layout_height="44dp"
                android:layout_marginTop="12dp"
                android:text="@string/label_finalizar_ruta"
                android:textColor="@color/white"
                android:textSize="13sp"
                app:backgroundTint="@color/alert_red"
                app:cornerRadius="12dp"
                app:layout_constraintTop_toBottomOf="@id/txt_km_ruta" />

        </androidx.constraintlayout.widget.ConstraintLayout>
    </com.google.android.material.card.MaterialCardView>

    <!-- Documentación Legal Section -->
    <TextView
        android:id="@+id/lbl_docs"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="32dp"
        android:text="@string/label_doc_legal"
        android:textColor="@color/text_light"
        android:textSize="16sp"
        android:textStyle="bold"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/card_en_ruta" />

    <LinearLayout
        android:id="@+id/ll_docs_row"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:layout_marginTop="16dp"
        app:layout_constraintTop_toBottomOf="@id/lbl_docs">

        <!-- SOAT -->
        <com.google.android.material.card.MaterialCardView
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:layout_marginEnd="8dp"
            app:cardBackgroundColor="@color/surface_card"
            app:cardCornerRadius="16dp"
            app:strokeWidth="0dp">
            <androidx.constraintlayout.widget.ConstraintLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:padding="16dp">
                <ImageView
                    android:id="@+id/ic_soat"
                    android:layout_width="20dp"
                    android:layout_height="20dp"
                    android:src="@android:drawable/ic_menu_sort_by_size"
                    app:tint="@color/cyan_primary"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintTop_toTopOf="parent"/>
                <View
                    android:id="@+id/dot_soat_estado"
                    android:layout_width="8dp"
                    android:layout_height="8dp"
                    android:background="@drawable/design_snackbar_background"
                    android:backgroundTint="@color/success_green"
                    app:layout_constraintEnd_toEndOf="parent"
                    app:layout_constraintTop_toTopOf="parent"/>
                <TextView
                    android:id="@+id/tv_soat"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="12dp"
                    android:text="@string/label_soat_short"
                    android:textColor="@color/text_light"
                    android:textSize="16sp"
                    android:textStyle="bold"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintTop_toBottomOf="@id/ic_soat" />
                <TextView
                    android:id="@+id/txt_soat_estado"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/label_vigente"
                    android:textColor="@color/success_green"
                    android:textSize="10sp"
                    android:textStyle="bold"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintTop_toBottomOf="@id/tv_soat" />
            </androidx.constraintlayout.widget.ConstraintLayout>
        </com.google.android.material.card.MaterialCardView>

        <!-- RTM -->
        <com.google.android.material.card.MaterialCardView
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:layout_marginStart="8dp"
            app:cardBackgroundColor="@color/surface_card"
            app:cardCornerRadius="16dp"
            app:strokeWidth="0dp">
            <androidx.constraintlayout.widget.ConstraintLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:padding="16dp">
                <ImageView
                    android:id="@+id/ic_rtm"
                    android:layout_width="20dp"
                    android:layout_height="20dp"
                    android:src="@android:drawable/ic_menu_manage"
                    app:tint="@color/cyan_primary"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintTop_toTopOf="parent"/>
                <View
                    android:id="@+id/dot_rtm_estado"
                    android:layout_width="8dp"
                    android:layout_height="8dp"
                    android:background="@drawable/design_snackbar_background"
                    android:backgroundTint="@color/success_green"
                    app:layout_constraintEnd_toEndOf="parent"
                    app:layout_constraintTop_toTopOf="parent"/>
                <TextView
                    android:id="@+id/tv_rtm"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="12dp"
                    android:text="@string/label_rtm_short"
                    android:textColor="@color/text_light"
                    android:textSize="16sp"
                    android:textStyle="bold"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintTop_toBottomOf="@id/ic_rtm" />
                <TextView
                    android:id="@+id/txt_rtm_estado"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/label_vigente"
                    android:textColor="@color/success_green"
                    android:textSize="10sp"
                    android:textStyle="bold"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintTop_toBottomOf="@id/tv_rtm" />
            </androidx.constraintlayout.widget.ConstraintLayout>
        </com.google.android.material.card.MaterialCardView>

    </LinearLayout>

    <TextView
        android:id="@+id/lbl_act"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="32dp"
        android:text="@string/label_actividad_reciente"
        android:textColor="@color/text_light"
        android:textSize="16sp"
        android:textStyle="bold"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/ll_docs_row" />

    <TextView
        android:id="@+id/txt_ver_historial"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="@string/label_ver_historial"
        android:textColor="@color/cyan_primary"
        android:textSize="12sp"
        android:clickable="true"
        android:focusable="true"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintBottom_toBottomOf="@id/lbl_act" />

    <!-- Actividad reciente -->
    <LinearLayout
        android:id="@+id/ll_list"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:layout_marginTop="16dp"
        android:layout_marginBottom="120dp"
        app:layout_constraintTop_toBottomOf="@id/lbl_act"
        app:layout_constraintBottom_toBottomOf="parent">

        <androidx.recyclerview.widget.RecyclerView
            android:id="@+id/rv_actividad_reciente"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:nestedScrollingEnabled="false"
            android:visibility="gone" />

        <TextView
            android:id="@+id/txt_sin_actividad_inicio"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:gravity="center"
            android:text="@string/label_no_actividad_desc"
            android:textColor="@color/gris_hint"
            android:textSize="13sp"
            android:visibility="gone" />

    </LinearLayout>

</androidx.constraintlayout.widget.ConstraintLayout>
