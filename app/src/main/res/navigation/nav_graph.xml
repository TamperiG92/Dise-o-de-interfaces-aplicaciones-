<?xml version="1.0" encoding="utf-8"?>
<navigation xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/nav_graph"
    app:startDestination="@id/navigation_home">

    <!-- Inicio -->
    <fragment
        android:id="@+id/navigation_home"
        android:name="com.example.rodapp.fragments.InicioFragment"
        android:label="Inicio"
        tools:layout="@layout/fragment_inicio" />

    <!-- Garaje (Estado Inicial/Vacío) -->
    <fragment
        android:id="@+id/navigation_garaje"
        android:name="com.example.rodapp.fragments.GarajeFragment"
        android:label="Mi Garaje"
        tools:layout="@layout/fragment_garaje" />

    <!-- Registro de Moto -->
    <fragment
        android:id="@+id/navigation_registro_moto"
        android:name="com.example.rodapp.fragments.RegistroMotoFragment"
        android:label="Registro de tu Moto"
        tools:layout="@layout/fragment_registro_moto" />

    <!-- Garaje con Documentos (Estado con Moto) -->
    <fragment
        android:id="@+id/navigation_garaje_documentos"
        android:name="com.example.rodapp.fragments.GarajeDocumentosFragment"
        android:label="Garaje"
        tools:layout="@layout/fragment_garaje_documentos" />

    <!-- Historial -->
    <fragment
        android:id="@+id/navigation_historial"
        android:name="com.example.rodapp.fragments.HistorialFragment"
        android:label="Historial"
        tools:layout="@layout/fragment_historial" />

    <!-- Perfil -->
    <fragment
        android:id="@+id/navigation_perfil"
        android:name="com.example.rodapp.fragments.PerfilFragment"
        android:label="Perfil"
        tools:layout="@layout/fragment_perfil" />

    <!-- Formulario Combustible -->
    <fragment
        android:id="@+id/navigation_combustible"
        android:name="com.example.rodapp.fragments.CombustibleFragment"
        android:label="Nuevo Combustible"
        tools:layout="@layout/fragment_combustible" />

    <!-- Formulario Mantenimiento -->
    <fragment
        android:id="@+id/navigation_mantenimiento"
        android:name="com.example.rodapp.fragments.MantenimientoFragment"
        android:label="Nuevo Mantenimiento"
        tools:layout="@layout/fragment_mantenimiento" />

    <!-- Registro de SOAT -->
    <fragment
        android:id="@+id/navigation_registro_soat"
        android:name="com.example.rodapp.fragments.RegistroSOATFragment"
        android:label="Registro de SOAT"
        tools:layout="@layout/fragment_registro_soat" />

    <!-- Registro de RTM -->
    <fragment
        android:id="@+id/navigation_registro_rtm"
        android:name="com.example.rodapp.fragments.RegistroRTMFragment"
        android:label="Registro de RTM"
        tools:layout="@layout/fragment_registro_rtm" />

    <!-- Documentos Adicionales -->
    <fragment
        android:id="@+id/navigation_documentos_adicionales"
        android:name="com.example.rodapp.fragments.DocumentosAdicionalesFragment"
        android:label="Documentos Adicionales"
        tools:layout="@layout/fragment_documentos_adicionales" />

    <!-- Nuevo Documento (Personalizado) -->
    <fragment
        android:id="@+id/navigation_nuevo_documento"
        android:name="com.example.rodapp.fragments.NuevoDocumentoFragment"
        android:label="Nuevo Documento"
        tools:layout="@layout/fragment_nuevo_documento" />

    <!-- Mapa (Visual) -->
    <fragment
        android:id="@+id/navigation_mapa"
        android:name="com.example.rodapp.fragments.MapaFragment"
        android:label="MapaFragment"
        tools:layout="@layout/fragment_mapa"/>

    <fragment
        android:id="@+id/documentoDetalleFragment"
        android:name="com.example.rodapp.fragments.DocumentoDetalleFragment"
        android:label="Detalle de Documento"
        tools:layout="@layout/fragment_documento_detalle" />

    <fragment
        android:id="@+id/navigation_cambiar_password"
        android:name="com.example.rodapp.fragments.CambiarPasswordFragment"
        android:label="Cambiar Contraseña"
        tools:layout="@layout/fragment_cambiar_password" />

</navigation>
