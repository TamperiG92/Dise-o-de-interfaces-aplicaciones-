<?xml version="1.0" encoding="utf-8"?>
<androidx.core.widget.NestedScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/background_blue"
    android:fillViewport="true">

    <androidx.constraintlayout.widget.ConstraintLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:paddingStart="24dp"
        android:paddingEnd="24dp"
        android:paddingTop="24dp"
        android:paddingBottom="100dp">

        <ImageButton
            android:id="@+id/btn_back_pass"
            android:layout_width="48dp"
            android:layout_height="48dp"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:contentDescription="@string/btn_back_desc"
            android:src="@android:drawable/ic_menu_revert"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent"
            app:tint="@color/white" />

        <TextView
            android:id="@+id/title_cambiar_pass"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/title_cambiar_password"
            android:textColor="@color/white"
            android:textSize="20sp"
            android:textStyle="bold"
            app:layout_constraintBottom_toBottomOf="@+id/btn_back_pass"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="@+id/btn_back_pass" />

        <TextView
            android:id="@+id/subtitle_cambiar_pass"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginTop="24dp"
            android:text="@string/subtitle_cambiar_password"
            android:textColor="@color/gris_hint"
            android:textSize="14sp"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@+id/btn_back_pass" />

        <TextView
            android:id="@+id/lbl_nueva_pass"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="32dp"
            android:text="@string/lbl_nueva_password"
            android:textColor="@color/button_blue"
            android:textSize="12sp"
            android:textStyle="bold"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@+id/subtitle_cambiar_pass" />

        <EditText
            android:id="@+id/et_nueva_password"
            android:layout_width="match_parent"
            android:layout_height="55dp"
            android:layout_marginTop="8dp"
            android:background="@drawable/texto_usuario"
            android:hint="@string/hint_pass_registro"
            android:inputType="textPassword"
            android:paddingStart="16dp"
            android:textColor="@color/white"
            android:textColorHint="@color/gris_hint"
            android:importantForAutofill="no"
            app:layout_constraintTop_toBottomOf="@+id/lbl_nueva_pass" />

        <TextView
            android:id="@+id/lbl_confirmar_pass"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:text="@string/lbl_confirmar_password"
            android:textColor="@color/button_blue"
            android:textSize="12sp"
            android:textStyle="bold"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@+id/et_nueva_password" />

        <EditText
            android:id="@+id/et_confirmar_password"
            android:layout_width="match_parent"
            android:layout_height="55dp"
            android:layout_marginTop="8dp"
            android:background="@drawable/texto_usuario"
            android:hint="@string/hint_confirmar_password"
            android:inputType="textPassword"
            android:paddingStart="16dp"
            android:textColor="@color/white"
            android:textColorHint="@color/gris_hint"
            android:importantForAutofill="no"
            app:layout_constraintTop_toBottomOf="@+id/lbl_confirmar_pass" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btn_cambiar_password"
            android:layout_width="match_parent"
            android:layout_height="60dp"
            android:layout_marginTop="32dp"
            android:text="@string/btn_cambiar_password"
            android:textAllCaps="false"
            android:textColor="@color/black"
            android:textStyle="bold"
            app:backgroundTint="@color/button_blue"
            app:cornerRadius="30dp"
            app:layout_constraintTop_toBottomOf="@+id/et_confirmar_password"
            app:layout_constraintBottom_toBottomOf="parent" />

    </androidx.constraintlayout.widget.ConstraintLayout>

</androidx.core.widget.NestedScrollView>
