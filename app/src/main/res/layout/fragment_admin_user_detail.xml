<?xml version="1.0" encoding="utf-8"?>
<androidx.core.widget.NestedScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/background_blue"
    android:fillViewport="true">

    <androidx.constraintlayout.widget.ConstraintLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:paddingBottom="40dp">

        <!-- Header -->
        <ImageButton
            android:id="@+id/btn_back_admin_detail"
            android:layout_width="48dp"
            android:layout_height="48dp"
            android:layout_marginStart="16dp"
            android:layout_marginTop="16dp"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:contentDescription="@string/btn_back_desc"
            android:src="@android:drawable/ic_menu_revert"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent"
            app:tint="@color/white" />

        <TextView
            android:id="@+id/title_admin_detail"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Detalle de Usuario"
            android:textColor="@color/white"
            android:textSize="20sp"
            android:textStyle="bold"
            app:layout_constraintBottom_toBottomOf="@+id/btn_back_admin_detail"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="@+id/btn_back_admin_detail" />

        <!-- User Info Card -->
        <com.google.android.material.card.MaterialCardView
            android:id="@+id/card_user_admin"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_margin="24dp"
            app:cardBackgroundColor="@color/dark_blue"
            app:cardCornerRadius="24dp"
            app:cardElevation="0dp"
            app:strokeColor="#1F3238"
            app:strokeWidth="1dp"
            app:layout_constraintTop_toBottomOf="@+id/title_admin_detail">

            <androidx.constraintlayout.widget.ConstraintLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:padding="20dp">

                <com.google.android.material.imageview.ShapeableImageView
                    android:id="@+id/iv_user_admin_detail"
                    android:layout_width="80dp"
                    android:layout_height="80dp"
                    android:scaleType="centerCrop"
                    android:src="@android:drawable/ic_menu_report_image"
                    android:contentDescription="@null"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintTop_toTopOf="parent"
                    app:shapeAppearanceOverlay="@style/CircleImage" />

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btn_status_user"
                    android:layout_width="wrap_content"
                    android:layout_height="28dp"
                    android:layout_marginStart="16dp"
                    android:text="● ACTIVO"
                    android:textSize="8sp"
                    android:textColor="#4CAF50"
                    android:padding="0dp"
                    android:insetTop="0dp"
                    android:insetBottom="0dp"
                    app:backgroundTint="#1A4CAF50"
                    app:cornerRadius="8dp"
                    app:layout_constraintStart_toEndOf="@+id/iv_user_admin_detail"
                    app:layout_constraintTop_toTopOf="@+id/iv_user_admin_detail" />

                <TextView
                    android:id="@+id/tv_name_admin_detail"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="4dp"
                    android:text="Juan Perez"
                    android:textColor="@color/white"
                    android:textSize="22sp"
                    android:textStyle="bold"
                    app:layout_constraintStart_toStartOf="@+id/btn_status_user"
                    app:layout_constraintTop_toBottomOf="@+id/btn_status_user" />

                <TextView
                    android:id="@+id/tv_id_admin_detail"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="ID: #RD-99231"
                    android:textColor="@color/button_blue"
                    android:textSize="12sp"
                    app:layout_constraintStart_toStartOf="@+id/tv_name_admin_detail"
                    app:layout_constraintTop_toBottomOf="@+id/tv_name_admin_detail" />

                <TextView
                    android:id="@+id/tv_location_admin"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="📍 Bogotá, Colombia"
                    android:textColor="@color/gris_hint"
                    android:textSize="12sp"
                    app:layout_constraintStart_toStartOf="@+id/tv_id_admin_detail"
                    app:layout_constraintTop_toBottomOf="@+id/tv_id_admin_detail" />

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="20dp"
                    android:orientation="horizontal"
                    android:baselineAligned="false"
                    app:layout_constraintTop_toBottomOf="@+id/iv_user_admin_detail">

                    <com.google.android.material.card.MaterialCardView
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:layout_marginEnd="8dp"
                        app:cardBackgroundColor="#132328"
                        app:cardCornerRadius="12dp">
                        <LinearLayout
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:orientation="vertical"
                            android:padding="12dp">
                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="STATUS"
                                android:textColor="@color/gris_hint"
                                android:textSize="10sp"
                                android:textStyle="bold" />
                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="PENDING VERIFICATION"
                                android:textColor="@color/button_blue"
                                android:textSize="10sp"
                                android:textStyle="bold" />
                        </LinearLayout>
                    </com.google.android.material.card.MaterialCardView>

                    <com.google.android.material.card.MaterialCardView
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:layout_marginStart="8dp"
                        app:cardBackgroundColor="#132328"
                        app:cardCornerRadius="12dp">
                        <LinearLayout
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:orientation="vertical"
                            android:padding="12dp">
                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="JOINED"
                                android:textColor="@color/gris_hint"
                                android:textSize="10sp"
                                android:textStyle="bold" />
                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="Oct 12, 2023"
                                android:textColor="@color/white"
                                android:textSize="12sp"
                                android:textStyle="bold" />
                        </LinearLayout>
                    </com.google.android.material.card.MaterialCardView>
                </LinearLayout>

            </androidx.constraintlayout.widget.ConstraintLayout>
        </com.google.android.material.card.MaterialCardView>

        <!-- Vehicle Info Header -->
        <TextView
            android:id="@+id/lbl_vehiculo_reg"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="24dp"
            android:layout_marginTop="24dp"
            android:text="VEHÍCULO REGISTRADO"
            android:textColor="@color/button_blue"
            android:textSize="12sp"
            android:textStyle="bold"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@+id/card_user_admin" />

        <!-- Vehicle Image Card -->
        <com.google.android.material.card.MaterialCardView
            android:id="@+id/card_moto_preview"
            android:layout_width="match_parent"
            android:layout_height="220dp"
            android:layout_marginHorizontal="24dp"
            android:layout_marginTop="8dp"
            app:cardCornerRadius="16dp"
            app:cardElevation="0dp"
            app:layout_constraintTop_toBottomOf="@+id/lbl_vehiculo_reg">
            <androidx.constraintlayout.widget.ConstraintLayout
                android:layout_width="match_parent"
                android:layout_height="match_parent">
                <ImageView
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:scaleType="centerCrop"
                    android:src="@android:drawable/ic_menu_gallery"
                    android:alpha="0.8"
                    android:contentDescription="@null" />
                <View
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:background="#66000000" />

                <TextView
                    android:id="@+id/tv_moto_model_name"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_margin="16dp"
                    android:text="Yamaha MT-03"
                    android:textColor="@color/white"
                    android:textStyle="bold"
                    android:textSize="20sp"
                    app:layout_constraintBottom_toTopOf="@+id/tv_moto_specs"
                    app:layout_constraintStart_toStartOf="parent" />

                <TextView
                    android:id="@+id/tv_moto_specs"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="16dp"
                    android:layout_marginBottom="100dp"
                    android:text="HYPER NAKED • 321CC"
                    android:textColor="@color/button_blue"
                    android:textStyle="bold"
                    android:textSize="12sp"
                    app:layout_constraintBottom_toBottomOf="parent"
                    app:layout_constraintStart_toStartOf="parent" />

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:padding="12dp"
                    app:layout_constraintBottom_toBottomOf="parent">
                    <com.google.android.material.card.MaterialCardView
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:layout_marginEnd="4dp"
                        app:cardBackgroundColor="#CC1A2B2F"
                        app:cardCornerRadius="8dp">
                        <LinearLayout
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:orientation="vertical"
                            android:gravity="center"
                            android:padding="8dp">
                            <ImageView android:layout_width="16dp" android:layout_height="16dp" android:src="@android:drawable/ic_menu_my_calendar" app:tint="@color/button_blue" android:contentDescription="@null"/>
                            <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="AÑO" android:textSize="8sp" android:textColor="@color/gris_hint" tools:ignore="SmallSp" />
                            <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="2024" android:textSize="10sp" android:textColor="@color/white" android:textStyle="bold"/>
                        </LinearLayout>
                    </com.google.android.material.card.MaterialCardView>
                    <com.google.android.material.card.MaterialCardView
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:layout_marginHorizontal="4dp"
                        app:cardBackgroundColor="#CC1A2B2F"
                        app:cardCornerRadius="8dp">
                        <LinearLayout
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:orientation="vertical"
                            android:gravity="center"
                            android:padding="8dp">
                            <ImageView android:layout_width="16dp" android:layout_height="16dp" android:src="@android:drawable/ic_menu_gallery" app:tint="@color/button_blue" android:contentDescription="@null"/>
                            <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="COLOR" android:textSize="8sp" android:textColor="@color/gris_hint" tools:ignore="SmallSp" />
                            <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="Icon Blue" android:textSize="10sp" android:textColor="@color/white" android:textStyle="bold"/>
                        </LinearLayout>
                    </com.google.android.material.card.MaterialCardView>
                    <com.google.android.material.card.MaterialCardView
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:layout_marginStart="4dp"
                        app:cardBackgroundColor="#CC1A2B2F"
                        app:cardCornerRadius="8dp">
                        <LinearLayout
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:orientation="vertical"
                            android:gravity="center"
                            android:padding="8dp">
                            <ImageView android:layout_width="16dp" android:layout_height="16dp" android:src="@android:drawable/ic_menu_slideshow" app:tint="@color/button_blue" android:contentDescription="@null"/>
                            <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="KILOM." android:textSize="8sp" android:textColor="@color/gris_hint" tools:ignore="SmallSp" />
                            <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="2,460 km" android:textSize="10sp" android:textColor="@color/white" android:textStyle="bold"/>
                        </LinearLayout>
                    </com.google.android.material.card.MaterialCardView>
                </LinearLayout>
            </androidx.constraintlayout.widget.ConstraintLayout>
        </com.google.android.material.card.MaterialCardView>

        <!-- Documentation Section -->
        <TextView
            android:id="@+id/lbl_docs_admin"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="24dp"
            android:layout_marginTop="32dp"
            android:text="DOCUMENTACIÓN"
            android:textColor="@color/button_blue"
            android:textSize="12sp"
            android:textStyle="bold"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@+id/card_moto_preview" />

        <!-- SOAT Auditor Card -->
        <com.google.android.material.card.MaterialCardView
            android:id="@+id/card_soat_audit"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginHorizontal="24dp"
            android:layout_marginTop="12dp"
            app:cardBackgroundColor="@color/dark_blue"
            app:cardCornerRadius="16dp"
            app:cardElevation="0dp"
            app:strokeColor="#1F3238"
            app:strokeWidth="1dp"
            app:layout_constraintTop_toBottomOf="@+id/lbl_docs_admin">
            <androidx.constraintlayout.widget.ConstraintLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:padding="12dp">
                <ImageView
                    android:id="@+id/iv_soat_icon"
                    android:layout_width="40dp"
                    android:layout_height="40dp"
                    android:src="@android:drawable/ic_menu_today"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintTop_toTopOf="parent"
                    app:tint="@color/button_blue"
                    android:contentDescription="@null" />
                <TextView
                    android:id="@+id/tv_soat_label"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="12dp"
                    android:text="SOAT"
                    android:textColor="@color/white"
                    android:textStyle="bold"
                    app:layout_constraintStart_toEndOf="@+id/iv_soat_icon"
                    app:layout_constraintTop_toTopOf="parent" />
                <TextView
                    android:id="@+id/tv_soat_status"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Vence: 12/08/2025"
                    android:textColor="@color/gris_hint"
                    android:textSize="12sp"
                    app:layout_constraintStart_toStartOf="@+id/tv_soat_label"
                    app:layout_constraintTop_toBottomOf="@+id/tv_soat_label" />

                <LinearLayout
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    app:layout_constraintEnd_toEndOf="parent"
                    app:layout_constraintTop_toTopOf="parent"
                    app:layout_constraintBottom_toBottomOf="parent">
                    <ImageButton
                        android:id="@+id/btn_view_soat"
                        android:layout_width="36dp"
                        android:layout_height="36dp"
                        android:src="@android:drawable/ic_menu_view"
                        app:tint="@color/button_blue"
                        android:background="@drawable/design_snackbar_background"
                        android:backgroundTint="#1A00BCD4"
                        android:layout_marginEnd="8dp"
                        android:contentDescription="Ver SOAT" />
                    <ImageButton
                        android:id="@+id/btn_approve_soat"
                        android:layout_width="36dp"
                        android:layout_height="36dp"
                        android:src="@android:drawable/checkbox_on_background"
                        app:tint="#4CAF50"
                        android:background="@drawable/design_snackbar_background"
                        android:backgroundTint="#1A4CAF50"
                        android:layout_marginEnd="8dp"
                        android:contentDescription="Aprobar SOAT" />
                    <ImageButton
                        android:id="@+id/btn_reject_soat"
                        android:layout_width="36dp"
                        android:layout_height="36dp"
                        android:src="@android:drawable/ic_menu_close_clear_cancel"
                        app:tint="@color/alert_red"
                        android:background="@drawable/design_snackbar_background"
                        android:backgroundTint="#1AFF5722"
                        android:contentDescription="Rechazar SOAT" />
                </LinearLayout>
            </androidx.constraintlayout.widget.ConstraintLayout>
        </com.google.android.material.card.MaterialCardView>

        <!-- RTM Auditor Card -->
        <com.google.android.material.card.MaterialCardView
            android:id="@+id/card_rtm_audit"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginHorizontal="24dp"
            android:layout_marginTop="12dp"
            app:cardBackgroundColor="@color/dark_blue"
            app:cardCornerRadius="16dp"
            app:cardElevation="0dp"
            app:strokeColor="#1F3238"
            app:strokeWidth="1dp"
            app:layout_constraintTop_toBottomOf="@+id/card_soat_audit">
            <androidx.constraintlayout.widget.ConstraintLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:padding="12dp">
                <ImageView
                    android:id="@+id/iv_rtm_icon"
                    android:layout_width="40dp"
                    android:layout_height="40dp"
                    android:src="@android:drawable/ic_menu_preferences"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintTop_toTopOf="parent"
                    app:tint="@color/button_blue"
                    android:contentDescription="@null" />
                <TextView
                    android:id="@+id/tv_rtm_label"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="12dp"
                    android:text="RTM"
                    android:textColor="@color/white"
                    android:textStyle="bold"
                    app:layout_constraintStart_toEndOf="@+id/iv_rtm_icon"
                    app:layout_constraintTop_toTopOf="parent" />
                <TextView
                    android:id="@+id/tv_rtm_status"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Vence: 20/08/2024"
                    android:textColor="@color/gris_hint"
                    android:textSize="12sp"
                    app:layout_constraintStart_toStartOf="@+id/tv_rtm_label"
                    app:layout_constraintTop_toBottomOf="@+id/tv_rtm_label" />

                <LinearLayout
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    app:layout_constraintEnd_toEndOf="parent"
                    app:layout_constraintTop_toTopOf="parent"
                    app:layout_constraintBottom_toBottomOf="parent">
                    <ImageButton
                        android:id="@+id/btn_view_rtm"
                        android:layout_width="36dp"
                        android:layout_height="36dp"
                        android:src="@android:drawable/ic_menu_view"
                        app:tint="@color/button_blue"
                        android:background="@drawable/design_snackbar_background"
                        android:backgroundTint="#1A00BCD4"
                        android:layout_marginEnd="8dp"
                        android:contentDescription="Ver RTM" />
                    <ImageButton
                        android:id="@+id/btn_approve_rtm"
                        android:layout_width="36dp"
                        android:layout_height="36dp"
                        android:src="@android:drawable/checkbox_on_background"
                        app:tint="#4CAF50"
                        android:background="@drawable/design_snackbar_background"
                        android:backgroundTint="#1A4CAF50"
                        android:layout_marginEnd="8dp"
                        android:contentDescription="Aprobar RTM" />
                    <ImageButton
                        android:id="@+id/btn_reject_rtm"
                        android:layout_width="36dp"
                        android:layout_height="36dp"
                        android:src="@android:drawable/ic_menu_close_clear_cancel"
                        app:tint="@color/alert_red"
                        android:background="@drawable/design_snackbar_background"
                        android:backgroundTint="#1AFF5722"
                        android:contentDescription="Rechazar RTM" />
                </LinearLayout>
            </androidx.constraintlayout.widget.ConstraintLayout>
        </com.google.android.material.card.MaterialCardView>

        <!-- Global Action Buttons -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:paddingHorizontal="24dp"
            android:layout_marginTop="32dp"
            app:layout_constraintTop_toBottomOf="@+id/card_rtm_audit">

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btn_reject_all"
                android:layout_width="0dp"
                android:layout_weight="1"
                android:layout_height="55dp"
                android:layout_marginEnd="8dp"
                android:text="RECHAZAR TODO"
                android:textAllCaps="false"
                android:textColor="@color/alert_red"
                app:strokeColor="@color/alert_red"
                app:strokeWidth="1dp"
                app:backgroundTint="@android:color/transparent"
                app:cornerRadius="12dp"
                app:icon="@android:drawable/ic_delete"
                app:iconTint="@color/alert_red" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btn_approve_all"
                android:layout_width="0dp"
                android:layout_weight="1"
                android:layout_height="55dp"
                android:layout_marginStart="8dp"
                android:text="APROBAR"
                android:textAllCaps="false"
                android:textColor="@color/black"
                app:backgroundTint="@color/button_blue"
                app:cornerRadius="12dp"
                app:icon="@android:drawable/checkbox_on_background"
                app:iconTint="@color/black" />
        </LinearLayout>

    </androidx.constraintlayout.widget.ConstraintLayout>
</androidx.core.widget.NestedScrollView>
