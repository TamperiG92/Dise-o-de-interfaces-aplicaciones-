<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:padding="24dp"
    android:background="@color/dark_blue">

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Motivo del Rechazo"
        android:textColor="@color/white"
        android:textSize="18sp"
        android:textStyle="bold" />

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:text="Indique al usuario por qué el documento no fue aprobado."
        android:textColor="@color/gris_hint"
        android:textSize="14sp" />

    <EditText
        android:id="@+id/et_motivo_rechazo"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="16dp"
        android:background="@drawable/texto_usuario"
        android:hint="Ej. Foto borrosa, datos no coinciden..."
        android:minHeight="100dp"
        android:gravity="top"
        android:padding="12dp"
        android:textColor="@color/white"
        android:textColorHint="@color/gris_hint"
        android:importantForAutofill="no"
        android:inputType="textMultiLine" />

</LinearLayout>
